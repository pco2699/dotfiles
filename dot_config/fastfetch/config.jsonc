// Light fastfetch config for the fish greeting.
// Regenerate a full reference with: fastfetch --gen-config-full
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // "small" = auto-detect the distro, but use its compact ASCII variant.
    "type": "small",
    "padding": { "top": 1, "right": 2 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 9 }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " ",
      "keyColor": "magenta"
    },
    {
      "type": "os",
      "key": "  ",
      "keyColor": "blue",
      "format": "{name} {version}"
    },
    {
      "type": "host",
      "key": "  ",
      "keyColor": "cyan",
      "format": "{name}"
    },
    {
      "type": "uptime",
      "key": " 󰅐 ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "  ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": " 󰋊 ",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "magenta",
      "format": "{pretty-name} {version}"
    },
    "break"
  ]
}
